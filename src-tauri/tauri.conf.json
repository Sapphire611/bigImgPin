{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bigImgPin",
  "version": "0.1.1",
  "identifier": "com.liuliyi.bigimgpin",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bigImgPin",
        "width": 1440,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Sapphire611/bigImgPin/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEMjEwODJENTc5OTVENEIKUldSTFhabFhMUWdoTFRETzEwUEg2TTZFT3lWaVNCK2JEZDN0RFovYjZXODNweEVLYngwL2VneUgK",
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "shortDescription": "面向十亿像素级工业图像的桌面查看与标注工具(自带 libvips,免配置)",
    "longDescription": "离线桌面端的超大图浏览与标注工具,面向工业版图、显微影像一类的十亿像素级图像。\n自带 libvips 运行时,装完即用,无需自行安装或配置任何依赖。\n本机把原图切成 DZI 瓦片金字塔并缓存,按视野按需加载,不把整图放进内存,因此图有多大都不影响交互。\n支持按图像像素坐标定位(x/y/w/h,可带偏移与系数换算)、标注框与辅助线、自适应网格与小地图。全程本地运行,图像不出本机。",
    "resources": {
      "resources/vips-win64": "vips-win64"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
